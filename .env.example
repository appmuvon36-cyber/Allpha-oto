# Browser-safe Supabase values only; never put service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only API endpoint; leave unset until FastAPI deployment is configured.
OTOCLINIC_API_BASE_URL=

# Server-only RajaOngkir Shipping Cost API (never expose these as NEXT_PUBLIC_*).
# Set RAJAONGKIR_API_KEY manually in the Railway otoclinic-api service.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN_ADDRESS=Desa Sasak Panjang, Kecamatan Tajur Halang, Kabupaten Bogor, Jawa Barat, Indonesia
RAJAONGKIR_ORIGIN_SEARCH=Sasak Panjang, Tajur Halang, Bogor, Jawa Barat
# Must be resolved from RajaOngkir's destination API using the real API key; do not guess.
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_DEFAULT_COURIERS=jne:jnt:sicepat:ide:sap:ninja:tiki:lion:anteraja:pos
RAJAONGKIR_QUOTE_TTL_SECONDS=900

# HMAC secret shared with Supabase Vault; server-side only.
RAJAONGKIR_QUOTE_SIGNING_SECRET=
